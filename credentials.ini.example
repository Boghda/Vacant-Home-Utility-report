# Copy this file to credentials.ini and fill in real values for LOCAL runs.
# credentials.ini is gitignored — never commit real credentials.
# In GitHub Actions these come from repository Secrets instead (see README).

[zendesk]
subdomain = your-subdomain
oauth_token = your_zendesk_oauth_access_token

[gmail]
email = your_sender@gmail.com
app_password = your_gmail_app_password

[email]
recipient = report_recipient@example.com
