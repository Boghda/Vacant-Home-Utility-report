# Copy this file to credentials.ini and fill in real values for LOCAL runs.
# credentials.ini is gitignored — never commit real credentials.
# In GitHub Actions these come from repository Secrets instead (see README).

[zendesk]
subdomain = your-subdomain
# The long-lived OAuth access token used by report_exporter.py at runtime.
# Mint it once from your client id/secret with: python get_zendesk_token.py
oauth_token = your_zendesk_oauth_access_token

# Used ONLY by get_zendesk_token.py to mint the access token above (one-time).
# report_exporter.py never reads this section.
[zendesk_oauth]
client_id = your_oauth_client_id
client_secret = your_oauth_client_secret
redirect_uri = http://localhost:8080/callback

[gmail]
email = your_sender@gmail.com
app_password = your_gmail_app_password

[email]
recipient = report_recipient@example.com
